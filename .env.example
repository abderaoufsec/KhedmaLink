# KhedmaLink Environment Configuration Example
# Copy this file to .env and fill in the actual values for your environment
# DO NOT commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name
APP_NAME=KhedmaLink

# Environment: development, staging, production
ENVIRONMENT=development

# Application version
APP_VERSION=0.1.0

# Debug mode (true/false)
DEBUG=true

# Application URL (for generating links, callbacks, etc.)
APP_URL=http://localhost:3000

# API base URL
API_BASE_URL=http://localhost:8000

# =============================================================================
# BACKEND SETTINGS (FastAPI)
# =============================================================================

# Backend host
BACKEND_HOST=0.0.0.0

# Backend port
BACKEND_PORT=8000

# Backend workers (for production)
BACKEND_WORKERS=4

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API prefix
API_PREFIX=/api/v1

# =============================================================================
# DATABASE SETTINGS (PostgreSQL)
# =============================================================================

# Database protocol
DB_PROTOCOL=postgresql

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database name
DB_NAME=khedmalink

# Database user
DB_USER=khedmalink_user

# Database password
DB_PASSWORD=your_secure_password_here

# Database connection pool size
DB_POOL_SIZE=20

# Database max overflow
DB_MAX_OVERFLOW=10

# Database connection timeout (seconds)
DB_TIMEOUT=30

# =============================================================================
# REDIS SETTINGS (Optional - for caching and background jobs)
# =============================================================================

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Redis connection pool size
REDIS_POOL_SIZE=10

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for JWT token signing (generate a strong random string)
SECRET_KEY=generate_a_very_secure_random_secret_key_here

# Algorithm for JWT tokens
JWT_ALGORITHM=HS256

# JWT access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing algorithm (bcrypt, argon2)
PASSWORD_HASH_ALGORITHM=bcrypt

# Password salt rounds (for bcrypt)
PASSWORD_SALT_ROUNDS=12

# =============================================================================
# FILE STORAGE SETTINGS (S3-compatible)
# =============================================================================

# Storage provider: local, s3, minio, other
STORAGE_PROVIDER=local

# S3 endpoint (for MinIO or other S3-compatible services)
S3_ENDPOINT=http://localhost:9000

# S3 access key
S3_ACCESS_KEY=your_s3_access_key

# S3 secret key
S3_SECRET_KEY=your_s3_secret_key

# S3 bucket name
S3_BUCKET=khedmalink

# S3 region
S3_REGION=us-east-1

# Local storage path (when using local provider)
LOCAL_STORAGE_PATH=./backend/uploads

# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=10

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =============================================================================
# EMAIL SETTINGS (Optional)
# =============================================================================

# Email provider: smtp, sendgrid, ses, mailgun
EMAIL_PROVIDER=smtp

# SMTP host
SMTP_HOST=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# SMTP username
SMTP_USERNAME=your_email@gmail.com

# SMTP password
SMTP_PASSWORD=your_email_password

# SMTP use TLS (true/false)
SMTP_USE_TLS=true

# Email from address
EMAIL_FROM=noreply@khedmalink.com

# Email from name
EMAIL_FROM_NAME=KhedmaLink

# =============================================================================
# SMS SETTINGS (Optional - for phone verification)
# =============================================================================

# SMS provider: twilio, nexmo, other
SMS_PROVIDER=

# Twilio account SID
TWILIO_ACCOUNT_SID=

# Twilio auth token
TWILIO_AUTH_TOKEN=

# Twilio phone number
TWILIO_PHONE_NUMBER=

# =============================================================================
# PAYMENT SETTINGS (Optional - for future payment integration)
# =============================================================================

# Payment provider: stripe, paypal, local, manual
PAYMENT_PROVIDER=manual

# Stripe publishable key
STRIPE_PUBLISHABLE_KEY=

# Stripe secret key
STRIPE_SECRET_KEY=

# Stripe webhook secret
STRIPE_WEBHOOK_SECRET=

# Commission rate (percentage)
COMMISSION_RATE=10.0

# =============================================================================
# ANALYTICS SETTINGS (Optional)
# =============================================================================

# Analytics provider: google_analytics, mixpanel, custom, none
ANALYTICS_PROVIDER=none

# Google Analytics tracking ID
GA_TRACKING_ID=

# Mixpanel token
MIXPANEL_TOKEN=

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log format: json, text
LOG_FORMAT=text

# Log file path (optional)
LOG_FILE_PATH=./logs/app.log

# Log rotation (true/false)
LOG_ROTATION=true

# Log max size (MB)
LOG_MAX_SIZE_MB=100

# Log backup count
LOG_BACKUP_COUNT=5

# =============================================================================
# FLUTTER / FRONTEND SETTINGS
# =============================================================================

# Flutter environment: development, staging, production
FLUTTER_ENV=development

# API endpoint for Flutter app
FLUTTER_API_ENDPOINT=http://10.0.2.2:8000  # 10.0.2.2 for Android emulator

# WebSocket endpoint for real-time features
FLUTTER_WS_ENDPOINT=ws://10.0.2.2:8000/ws

# Enable analytics (true/false)
FLUTTER_ENABLE_ANALYTICS=false

# Enable crash reporting (true/false)
FLUTTER_ENABLE_CRASH_REPORTING=false

# =============================================================================
# LOCALIZATION SETTINGS
# =============================================================================

# Default language: ar, fr
DEFAULT_LANGUAGE=ar

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=ar,fr

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable registration (true/false)
FEATURE_REGISTRATION=true

# Enable provider verification (true/false)
FEATURE_PROVIDER_VERIFICATION=true

# Enable payment processing (true/false)
FEATURE_PAYMENTS=false

# Enable messaging (true/false)
FEATURE_MESSAGING=true

# Enable reviews (true/false)
FEATURE_REVIEWS=true

# Enable disputes (true/false)
FEATURE_DISPUTES=true

# Enable admin panel (true/false)
FEATURE_ADMIN_PANEL=true

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================

# Enable rate limiting (true/false)
RATE_LIMITING_ENABLED=true

# Rate limit requests per minute
RATE_LIMIT_PER_MINUTE=60

# Rate limit requests per hour
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# GEOGRAPHY SETTINGS
# =============================================================================

# Default city
DEFAULT_CITY=Blida

# Default country
DEFAULT_COUNTRY=Algeria

# Default country code (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=DZ

# Default currency
DEFAULT_CURRENCY=DZD

# =============================================================================
# OPERATIONAL SETTINGS
# =============================================================================

# Maintenance mode (true/false)
MAINTENANCE_MODE=false

# Maintenance message (shown to users when maintenance mode is on)
MAINTENANCE_MESSAGE=KhedmaLink is currently under maintenance. Please try again later.

# Support email
SUPPORT_EMAIL=support@khedmalink.com

# Support phone
SUPPORT_PHONE=+213 XXX XXX XXX

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable hot reload (true/false)
HOT_RELOAD=true

# Enable debug toolbar (true/false)
DEBUG_TOOLBAR=true

# Enable swagger UI (true/false)
SWAGGER_UI_ENABLED=true

# Enable ReDoc (true/false)
REDOC_ENABLED=true

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================

# Health check endpoint enabled (true/false)
HEALTH_CHECK_ENABLED=true

# Enable metrics collection (true/false)
METRICS_ENABLED=false

# Metrics endpoint
METRICS_ENDPOINT=/metrics

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Enable automatic backups (true/false)
AUTO_BACKUP_ENABLED=false

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

# =============================================================================
# THIRD-PARTY API KEYS (Optional)
# =============================================================================

# Google Maps API key (for future map integration)
GOOGLE_MAPS_API_KEY=

# Firebase configuration (for future push notifications)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Replace all placeholder values with actual configuration for your environment
# 2. Generate strong random values for SECRET_KEY and other security-sensitive fields
# 3. Never commit the actual .env file to version control
# 4. Use different .env files for different environments (development, staging, production)
# 5. Keep production secrets secure and rotate them regularly
# 6. Some settings are optional and can be left empty if not needed
