build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
python-lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
