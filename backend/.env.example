# KhedmaLink Backend Environment Configuration
# Copy this file to .env and fill in actual values for your environment

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL database URL (using asyncpg for async support)
DATABASE_URL=postgresql+asyncpg://khedmalink_user:khedmalink_password@localhost:5432/khedmalink

# PostgreSQL individual settings (used by Docker Compose)
POSTGRES_USER=khedmalink_user
POSTGRES_PASSWORD=khedmalink_password
POSTGRES_DB=khedmalink
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name
APP_NAME=KhedmaLink
APP_DESCRIPTION=Trusted local-services marketplace for Blida, Algeria
APP_VERSION=0.1.0

# Environment
ENVIRONMENT=development

# Debug mode
DEBUG=true

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Server host
HOST=0.0.0.0

# Server port
PORT=8000

# =============================================================================
# API SETTINGS
# =============================================================================

# API v1 prefix
API_V1_PREFIX=/api/v1

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for JWT tokens (change in production!)
SECRET_KEY=your-secret-key-change-in-production-use-secure-random-string

# JWT algorithm
ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=text

# =============================================================================
# REDIS SETTINGS (Optional)
# =============================================================================

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# =============================================================================
# FILE STORAGE SETTINGS
# =============================================================================

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Upload directory
UPLOAD_DIR=uploads

# =============================================================================
# TIMEZONE SETTINGS
# =============================================================================

# Application timezone
TIMEZONE=Africa/Algiers
